from flask import request, jsonify, Blueprint
from __init__ import db
from admin.models.topology import Topology
from datetime import datetime
import json

# Sample topologies data based on the topology.html implementation
sample_topologies = [
    # ... existing sample topologies ...
]

class TopologyController:
    
    def get_all_topologies(self):
        """Get all topology challenges"""
        try:
            topologies = Topology.query.all()
            # If no topologies are found, return sample data
            if not topologies:
                print("No topologies found in database, returning sample data")
                return jsonify(sample_topologies), 200
            return jsonify([topology.to_dict() for topology in topologies]), 200
        except Exception as e:
            print(f"Error getting topologies: {str(e)}")
            # Return sample data even if there's an error
            return jsonify(sample_topologies), 200
    
    def get_topology(self, topology_id):
        """Get a specific topology challenge by ID"""
        try:
            topology = Topology.query.get(topology_id)
            if topology:
                return jsonify(topology.to_dict()), 200
            else:
                # Return a sample topology if not found
                for sample in sample_topologies:
                    if sample["id"] == topology_id:
                        print(f"DEBUG: Returning sample topology for ID {topology_id}")
                        return jsonify(sample), 200
                # If specific ID not found in samples, return the first sample
                print(f"DEBUG: Topology ID {topology_id} not found, returning default sample")
                return jsonify(sample_topologies[0]), 200
        except Exception as e:
            print(f"Error getting topology {topology_id}: {str(e)}")
            # Return first sample topology on error
            return jsonify(sample_topologies[0]), 200
    
    def create_topology(self):
        """Create a new topology challenge"""
        data = request.json
        
        if not data or not all(k in data for k in ['title', 'description', 'expected_config']):
            return jsonify({"error": "Missing required fields"}), 400
        
        try:
            # Create new topology object
            new_topology = Topology(
                title=data['title'],
                description=data['description'],
                difficulty=data.get('difficulty', 'medium'),
                topology_type=data.get('topology_type', 'point-to-point'),
                base_score=data.get('base_score', 10),
                time_bonus=data.get('time_bonus', 0),
                perfect_match_bonus=data.get('perfect_match_bonus', 5),
                is_active=data.get('is_active', True)
            )
            
            # Set configuration fields
            if 'initial_config' in data:
                new_topology.initial_config = data['initial_config']
            
            new_topology.expected_config = data['expected_config']
            
            # Set scoring metrics and device requirements if provided
            if 'scoring_metrics' in data:
                new_topology.scoring_metrics = data['scoring_metrics']
                
            if 'device_requirements' in data:
                new_topology.device_requirements = data['device_requirements']
            
            # Save to database
            db.session.add(new_topology)
            db.session.commit()
            
            return jsonify({"message": "Topology created successfully", "id": new_topology.id}), 201
        
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": str(e)}), 500
    
    def update_topology(self, topology_id):
        """Update an existing topology challenge"""
        try:
            print(f"Updating topology with ID: {topology_id}")
            topology = Topology.query.get(topology_id)
            
            if not topology:
                return jsonify({"error": f"Topology with ID {topology_id} not found"}), 404
                
            data = request.json
            print(f"Received data: {data.keys() if data else 'No data'}")
            
            if not data:
                return jsonify({"error": "No data provided"}), 400
            
            try:
                # Update basic fields
                if 'title' in data:
                    topology.title = data['title']
                    print(f"Updated title to: {data['title']}")
                
                if 'description' in data:
                    topology.description = data['description']
                    print(f"Updated description")
                
                if 'difficulty' in data:
                    topology.difficulty = data['difficulty']
                    print(f"Updated difficulty to: {data['difficulty']}")
                    
                if 'topology_type' in data:
                    topology.topology_type = data['topology_type']
                    print(f"Updated topology_type to: {data['topology_type']}")
                    
                if 'base_score' in data:
                    topology.base_score = data['base_score']
                    print(f"Updated base_score to: {data['base_score']}")
                    
                if 'time_bonus' in data:
                    topology.time_bonus = data['time_bonus']
                    print(f"Updated time_bonus to: {data['time_bonus']}")
                    
                if 'perfect_match_bonus' in data:
                    topology.perfect_match_bonus = data['perfect_match_bonus']
                    print(f"Updated perfect_match_bonus to: {data['perfect_match_bonus']}")
                    
                if 'is_active' in data:
                    topology.is_active = data['is_active']
                    print(f"Updated is_active to: {data['is_active']}")
                    
                # Update configuration fields
                if 'initial_config' in data:
                    try:
                        print(f"Setting initial_config: {type(data['initial_config'])}")
                        topology.initial_config = data['initial_config']
                        print("initial_config updated successfully")
                    except Exception as e:
                        print(f"Error setting initial_config: {str(e)}")
                        return jsonify({"error": f"Error setting initial_config: {str(e)}"}), 500
                
                if 'expected_config' in data:
                    try:
                        print(f"Setting expected_config: {type(data['expected_config'])}")
                        topology.expected_config = data['expected_config']
                        print("expected_config updated successfully")
                    except Exception as e:
                        print(f"Error setting expected_config: {str(e)}")
                        return jsonify({"error": f"Error setting expected_config: {str(e)}"}), 500
                    
                # Update scoring metrics and device requirements if provided
                if 'scoring_metrics' in data:
                    try:
                        print(f"Setting scoring_metrics: {type(data['scoring_metrics'])}")
                        topology.scoring_metrics = data['scoring_metrics']
                        print("scoring_metrics updated successfully")
                    except Exception as e:
                        print(f"Error setting scoring_metrics: {str(e)}")
                        return jsonify({"error": f"Error setting scoring_metrics: {str(e)}"}), 500
                    
                if 'device_requirements' in data:
                    try:
                        print(f"Setting device_requirements: {type(data['device_requirements'])}")
                        topology.device_requirements = data['device_requirements']
                        print("device_requirements updated successfully")
                    except Exception as e:
                        print(f"Error setting device_requirements: {str(e)}")
                        return jsonify({"error": f"Error setting device_requirements: {str(e)}"}), 500
                
                # Update the updated_at timestamp
                topology.updated_at = datetime.utcnow()
                
                try:
                    print("About to commit changes to database")
                    # Save to database
                    db.session.commit()
                    print("Changes committed successfully")
                    
                    return jsonify({"message": "Topology updated successfully", "id": topology.id}), 200
                except Exception as e:
                    print(f"Error committing to database: {str(e)}")
                    db.session.rollback()
                    return jsonify({"error": f"Database error: {str(e)}"}), 500
            
            except Exception as e:
                print(f"Error updating topology data: {str(e)}")
                db.session.rollback()
                return jsonify({"error": f"Data error: {str(e)}"}), 500
        
        except Exception as e:
            print(f"Error in update_topology: {str(e)}")
            return jsonify({"error": str(e)}), 500
    
    def delete_topology(self, topology_id):
        """Delete a topology challenge"""
        topology = Topology.query.get_or_404(topology_id)
        
        try:
            db.session.delete(topology)
            db.session.commit()
            return jsonify({"message": "Topology deleted successfully"}), 200
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": str(e)}), 500
    
    def preview_topology(self, topology_id):
        """Get a topology in a format suitable for previewing"""
        try:
            topology = Topology.query.get(topology_id)
            if topology:
                return jsonify(topology.to_dict()), 200
            else:
                # Return a sample topology if not found
                for sample in sample_topologies:
                    if sample["id"] == topology_id:
                        return jsonify(sample), 200
                return jsonify({"error": "Topology not found"}), 404
        except Exception as e:
            return jsonify({"error": str(e)}), 500
    
    def toggle_topology_status(self, topology_id):
        """Toggle the active status of a topology"""
        topology = Topology.query.get_or_404(topology_id)
        
        try:
            # Toggle the is_active field
            topology.is_active = not topology.is_active
            db.session.commit()
            
            return jsonify({
                "message": f"Topology is now {'active' if topology.is_active else 'inactive'}",
                "is_active": topology.is_active
            }), 200
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": str(e)}), 500
