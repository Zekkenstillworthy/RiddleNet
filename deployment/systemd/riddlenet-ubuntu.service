[Unit]
Description=RiddleNet Flask-SocketIO Application
Documentation=https://github.com/Zekkenstillworthy/RiddleNet
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/RiddleNet
Environment="PATH=/home/ubuntu/RiddleNet/venv/bin"
EnvironmentFile=/home/ubuntu/RiddleNet/.env
ExecStart=/home/ubuntu/RiddleNet/venv/bin/gunicorn --config gunicorn.conf.py wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
TimeoutStopSec=120
KillMode=mixed
KillSignal=SIGTERM

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ubuntu/RiddleNet/logs /tmp
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Performance settings
LimitNOFILE=65536
LimitNPROC=32768

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=riddlenet

[Install]
WantedBy=multi-user.target
