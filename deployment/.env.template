
# Environment Variables Template for AWS Deployment
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=production

# Database Configuration (RDS PostgreSQL)
DATABASE_URL=postgresql://riddlenet_admin:your_password@your-rds-endpoint.region.rds.amazonaws.com:5432/riddlenet
RDS_HOSTNAME=your-rds-endpoint.region.rds.amazonaws.com
RDS_USERNAME=riddlenet_admin
RDS_PASSWORD=your_secure_password
RDS_PORT=5432
RDS_DB_NAME=riddlenet

# AWS S3 Configuration
AWS_S3_BUCKET=riddlenet-static-files-your-unique-suffix
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Mail Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Security Settings
CORS_ORIGINS=https://your-domain.com,https://your-eb-url.elasticbeanstalk.com

# Logging
LOG_LEVEL=INFO

# Example values for reference:
# SECRET_KEY=super-secret-key-for-production-please-change
# DATABASE_URL=postgresql://riddlenet_admin:MySecurePass123@riddlenet-db.c9xyz123456.us-east-1.rds.amazonaws.com:5432/riddlenet
# AWS_S3_BUCKET=riddlenet-static-prod-bucket
# MAIL_SERVER=smtp.sendgrid.net