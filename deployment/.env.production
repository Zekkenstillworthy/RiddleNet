
# Production Environment Variables for RiddleNet
# Copy these to your Elastic Beanstalk environment

SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=production

# Database Configuration (Replace with your actual RDS values)
DATABASE_URL=postgresql://riddlenet_admin:your_password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/riddlenet
RDS_HOSTNAME=your-rds-endpoint.us-east-1.rds.amazonaws.com
RDS_USERNAME=riddlenet_admin
RDS_PASSWORD=your_secure_password
RDS_PORT=5432
RDS_DB_NAME=riddlenet

# AWS S3 Configuration (Already configured with your bucket)
AWS_S3_BUCKET=riddlenet-static-files-20250923
AWS_S3_REGION=ap-southeast-2

# Optional: Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Security Settings
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO