<!-- 
=============================================================================
CHALLENGE PROGRESS INTEGRATION TEMPLATE - MVP
Copy this template and adapt it for your challenge
=============================================================================
-->

<!-- STEP 1: Include the Continue Game Modal (inside {% block content %}) -->
{% include 'components/continue_game_modal.html' %}

<!-- STEP 2: Include the Progress Manager Script (before closing </body>) -->
<script src="{{ url_for('static', filename='js/challenge-progress-manager.js') }}"></script>

<!-- STEP 3: Add this to your challenge's <script> section -->
<script>
// ============================================================================
// CHALLENGE PROGRESS INTEGRATION - MVP
// Replace 'CHALLENGE_TYPE' with your challenge identifier
// Examples: 'crimping', 'osi', 'linkup', 'quiz', 'troubleshoot'
// ============================================================================

// Initialize progress manager with your challenge type
window.challengeProgress = new ChallengeProgressManager('CHALLENGE_TYPE');

// Check for saved progress on page load
document.addEventListener('DOMContentLoaded', async function() {
    await window.challengeProgress.checkForProgress();
    
    // Your existing DOMContentLoaded code here...
});

// Listen for load saved game event
document.addEventListener('loadSavedGame', function(e) {
    const savedState = e.detail.state;
    
    if (savedState) {
        // ====================================================================
        // RESTORE YOUR CHALLENGE STATE HERE
        // Replace these with your actual game state variables
        // ====================================================================
        currentLevel = savedState.currentLevel || 1;
        score = savedState.score || 0;
        // Add more state restoration as needed...
        
        console.log('✅ Game state restored');
    }
    
    // Start your game/challenge
    startGame(); // Replace with your start function
});

// Listen for start new game event
document.addEventListener('startNewGame', function() {
    // ====================================================================
    // RESET YOUR CHALLENGE STATE HERE
    // Set everything back to initial values
    // ====================================================================
    currentLevel = 1;
    score = 0;
    // Reset more state as needed...
    
    // Start fresh game
    startGame(); // Replace with your start function
});

// ====================================================================
// DEFINE YOUR STATE GETTER FUNCTION
// This function should return ALL the state you want to save
// ====================================================================
function getGameState() {
    return {
        // Add all your game state variables here
        currentLevel: currentLevel,
        score: score,
        // Add more as needed...
        timestamp: Date.now()
    };
}

// Start auto-save (saves every 10 seconds)
window.challengeProgress.startAutoSave(getGameState);

// Save on page exit
window.challengeProgress.setupBeforeUnloadSave(getGameState);

// ====================================================================
// OPTIONAL: Manual save on specific events
// ====================================================================

// Example: Save when completing a level
function completeLevel() {
    // Your level completion code...
    
    // Manually save progress
    window.challengeProgress.saveImmediately(getGameState());
}

// Example: Mark as completed when challenge is done
function completeChallenge() {
    // Your completion code...
    
    // Mark as completed (stops auto-save, won't show continue prompt)
    window.challengeProgress.markCompleted(getGameState());
}

// ====================================================================
// YOUR EXISTING CHALLENGE CODE CONTINUES HERE...
// ====================================================================

</script>

<!-- 
=============================================================================
INTEGRATION CHECKLIST
=============================================================================

Before testing:
[ ] Replace 'CHALLENGE_TYPE' with unique identifier (e.g., 'crimping')
[ ] Fill in state restoration in loadSavedGame listener
[ ] Fill in state reset in startNewGame listener  
[ ] Define getGameState() with all state variables you want to save
[ ] Replace startGame() with your actual start function
[ ] Test "Continue Game" restores state correctly
[ ] Test "Start Fresh" resets state correctly
[ ] Test auto-save works (check console logs)
[ ] Test exit save works (leave page and return)
[ ] Test completion (challenge marked complete, no prompt on return)

=============================================================================
-->
